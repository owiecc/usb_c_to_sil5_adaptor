import Resistor

from "connectors/UJC-HP-3-SMT-TR.ato" import UJC_HP_3_SMT_TR

module App:
    signal VCC
    signal GND

    R1 = new Resistor
    R1.resistance = 5.1kΩ ± 1%
    R1.package = "R0402"
    R2 = new Resistor
    R2.resistance = 5.1kΩ ± 1%
    R2.package = "R0402"

    R1.p2 ~ GND
    R2.p2 ~ GND

    USBC = new UJC_HP_3_SMT_TR
    USBC.CC1 ~ R1.p1
    USBC.CC2 ~ R2.p1
    USBC.V_BUS ~ VCC
    USBC.GND ~ GND